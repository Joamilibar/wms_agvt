# MongoDB
MONGO_USER=wms_admin
MONGO_PASSWORD=superSecretPass123
# Desde el host (npm run start:dev en apps/api).
# directConnection=true: el miembro del replica set se anuncia como `mongo:27017`,
# nombre que solo resuelve dentro de la red de compose. Conectando directo al
# primario se saltan el descubrimiento de topologia y las transacciones funcionan igual.
MONGODB_URI=mongodb://wms_admin:superSecretPass123@localhost:27017/wms_pro?authSource=admin&directConnection=true

# Redis
REDIS_PASSWORD=redisSecretPass
REDIS_URL=redis://:redisSecretPass@localhost:6379

# JWT
JWT_SECRET=cambiar_por_secreto_de_64_chars_minimo_en_produccion_wms_pro_2026
# M-08: access token corto + refresh revocable con rotacion.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# BSale (opcional - el sistema funciona sin token)
BSALE_TOKEN=
BSALE_BASE_URL=https://api.bsale.cl/v1

# App
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Seed
# Con la base vacia se crea siempre el primer admin. En produccion
# SEED_ADMIN_PASSWORD es obligatoria y no puede ser el default de desarrollo.
SEED_ADMIN_EMAIL=admin@cabodehornos.cl
SEED_ADMIN_PASSWORD=Admin123!
# Datos demo (lotes, ordenes, guias y dos operadores). Por defecto solo fuera
# de produccion; SEED_DEMO_DATA=true|false lo fuerza en cualquier entorno.
# SEED_DEMO_DATA=true
SEED_OPERATOR_PASSWORD=Operador123!
